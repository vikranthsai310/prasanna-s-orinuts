rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS FOR SECURITY
    // ============================================
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Check if user is admin (by checking Firestore document - FULLY DYNAMIC!)
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Check if user is Super Admin (by checking adminRole in Firestore document)
    function isSuperAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('adminRole', null) == 'super-admin';
    }
    
    // Backup: Check if phone is super admin phone (for initial setup only)
    function isSuperAdminPhone() {
      return isSignedIn() && 
        request.auth.token.phone_number in ['+916301308477', '+918555856366'];
    }
    
    // Alias for backwards compatibility
    function isAdminPhone() {
      return isSuperAdminPhone();
    }
    
    // Validate string length
    function validString(value, minLen, maxLen) {
      return value is string && 
             value.size() >= minLen && 
             value.size() <= maxLen;
    }
    
    // Validate phone number (international format +91XXXXXXXXXX)
    function validPhone(phone) {
      return phone is string && 
             phone.matches('\\+91[6-9][0-9]{9}');
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Allow users to read their own profile or admins to read any profile
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow users to create their own profile with phone number
      allow create: if isOwner(userId) && 
                       request.resource.data.phone is string &&
                       validString(request.resource.data.name, 1, 100);
      
      // Allow users to update their own profile (but not admin status unless already admin)
      allow update: if isOwner(userId) && (
                       request.resource.data.isAdmin == resource.data.isAdmin ||
                       isAdminPhone()
                     );
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // ============================================
    // PRODUCTS COLLECTION
    // ============================================
    match /products/{productId} {
      // Anyone can read products
      allow read: if true;
      
      // Admins can do anything with products
      allow create, delete: if isAdmin();
      
      // Allow updates: Admins can update anything, 
      // Authenticated users can ONLY decrement stock (for order placement)
      allow update: if isAdmin() || 
                       (isSignedIn() && 
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
                        request.resource.data.stock < resource.data.stock);
    }
    
    // ============================================
    // ORDERS COLLECTION
    // ============================================
    match /orders/{orderId} {
      // Users can read their own orders, admins can read all
      allow read: if isSignedIn() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can create their own orders (userId must match their auth.uid)
      allow create: if isSignedIn() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Users can update their own orders' payment status (for payment callbacks)
      // Admins can update any order
      allow update: if isSignedIn() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
      
      // Only admins can delete orders
      allow delete: if isAdmin();
    }
    
    // Allow collection queries - but individual document rules still apply
    match /orders {
      allow list: if isSignedIn();
    }
    
    // ============================================
    // ADDRESSES COLLECTION
    // ============================================
    match /addresses/{addressId} {
      // Users can read their own addresses
      allow read: if isSignedIn() && 
                     resource.data.userId == request.auth.uid;
      
      // Users can create their own addresses with validation
      allow create: if isSignedIn() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Users can update their own addresses
      allow update: if isSignedIn() && 
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
      
      // Users can delete their own addresses
      allow delete: if isSignedIn() && 
                       resource.data.userId == request.auth.uid;
    }
    
    // ============================================
    // REVIEWS COLLECTION
    // ============================================
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      
      // Authenticated users can create reviews
      allow create: if isSignedIn() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Users can update their own reviews
      allow update: if isSignedIn() && 
                       resource.data.userId == request.auth.uid;
      
      // Users can delete their own reviews, admins can delete any
      allow delete: if isSignedIn() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // ============================================
    // CART COLLECTION
    // ============================================
    match /carts/{cartId} {
      // Users can only access their own cart
      allow read, write: if isSignedIn() && 
                            cartId == request.auth.uid;
    }
    
    // ============================================
    // ANALYTICS (Admin only)
    // ============================================
    match /analytics/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // ============================================
    // COUPONS COLLECTION
    // ============================================
    match /coupons/{couponId} {
      // Anyone can read active coupons (needed for validation at checkout)
      allow read: if true;
      
      // Only admins can create/update/delete coupons
      allow create, update, delete: if isAdmin();
    }
    
    // Allow collection queries for coupons
    match /coupons {
      allow list: if true; // Anyone can list coupons (for validation)
    }
    
    // ============================================
    // PRODUCT DISCOUNTS COLLECTION
    // ============================================
    match /productDiscounts/{productId} {
      // Anyone can read discounts (needed to display discounted prices)
      allow read: if true;
      
      // Only admins can create/update/delete discounts
      allow create, update, delete: if isAdmin();
    }
    
    // Allow collection queries for product discounts
    match /productDiscounts {
      allow list: if true; // Anyone can list discounts
    }
    
    // ============================================
    // SAMPLE PRODUCTS COLLECTION
    // ============================================
    match /sampleProducts/{sampleId} {
      // Anyone can read active samples (needed for sample selection page)
      allow read: if true;
      
      // Admins can do anything with sample products
      allow create, delete: if isAdmin();
      
      // Allow updates: Admins can update anything,
      // Authenticated users can ONLY decrement stock (for order placement)
      allow update: if isAdmin() || 
                       (isSignedIn() && 
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']) &&
                        request.resource.data.stock < resource.data.stock);
    }
    
    // Allow collection queries for samples
    match /sampleProducts {
      allow list: if true; // Anyone can list samples
    }
    
    // ============================================
    // COUPON USAGE TRACKING
    // ============================================
    match /couponUsage/{usageId} {
      // Users can read their own coupon usage, admins can read all
      allow read: if isSignedIn() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      
      // System can create usage records (when order is placed)
      allow create: if isSignedIn() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Only admins can update/delete usage records
      allow update, delete: if isAdmin();
    }
    
    // Allow collection queries for coupon usage (admins only for stats)
    match /couponUsage {
      allow list: if isAdmin(); // Admins can query all usage for statistics
    }
    
    // ============================================
    // SETTINGS COLLECTION (Shipping, etc.)
    // ============================================
    match /settings/{settingId} {
      // Anyone can read settings (needed for shipping calculations)
      allow read: if true;
      
      // Only admins can create/update/delete settings
      allow create, update, delete: if isAdmin();
    }
    
    // Allow collection queries for settings
    match /settings {
      allow list: if true; // Anyone can list settings
    }
    
    // ============================================
    // DENY ALL OTHER COLLECTIONS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 