# Firebase Configuration (Frontend - Public)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 🔐 Firebase Admin SDK (Backend - KEEP SECRET!)
# This is the entire service account JSON as a single-line string
# Required for API authentication and server-side Firebase operations
# Get from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Then minify the JSON: Remove all line breaks and extra spaces
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id",...}'

# Razorpay Configuration
# Public key (safe to expose in frontend)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
# Secret key (NEVER expose in frontend - used in API routes only)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Delhivery Configuration
# Get your API token from: https://www.delhivery.com/ -> Login -> Settings -> API
# IMPORTANT: All Delhivery variables must have VITE_ prefix to be accessible in the frontend
VITE_DELHIVERY_API_TOKEN=your_10_digit_delhivery_api_token
# Set to 'true' for production, 'false' for testing with staging URL
VITE_DELHIVERY_PRODUCTION=false
VITE_DELHIVERY_CLIENT_NAME=Prasannas-orinuts

# Warehouse/Pickup Location Details (All must have VITE_ prefix)
VITE_DELHIVERY_WAREHOUSE_NAME=Premium Orchard Warehouse
VITE_DELHIVERY_PICKUP_ADDRESS=Your_warehouse_address_here
VITE_DELHIVERY_PICKUP_CITY=Your_city
VITE_DELHIVERY_PICKUP_STATE=Your_state
VITE_DELHIVERY_PICKUP_PINCODE=110001
VITE_DELHIVERY_PICKUP_PHONE=9876543210
VITE_DELHIVERY_PICKUP_CONTACT=Contact_person_name

# Environment
VITE_ENV=development

# ===================================
# GEMINI AI CONFIGURATION
# ===================================

# Google Gemini AI API Key (For AI Assistant in Admin Panel)
# Get your API key from: https://makersuite.google.com/app/apikey
# Features: Auto-fill nutritional info, Generate product descriptions
VITE_GEMINI_API_KEY=your_gemini_api_key_here
