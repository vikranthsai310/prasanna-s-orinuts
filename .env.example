# Firebase Configuration (Frontend - Public)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 🔐 Firebase Admin SDK (Backend - KEEP SECRET!)
# This is the entire service account JSON as a single-line string
# Required for API authentication and server-side Firebase operations
# Get from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Then minify the JSON: Remove all line breaks and extra spaces
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id",...}'

# Razorpay Configuration
# Public key (safe to expose in frontend)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
# Secret key (NEVER expose in frontend - used in API routes only)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Shiprocket Configuration
# Get your credentials from: https://www.shiprocket.in/ -> Login -> Settings -> API
# Email and Password for API authentication
# Token is auto-generated via POST to https://apiv2.shiprocket.in/v1/external/auth/login
VITE_SHIPROCKET_EMAIL=your_shiprocket_email@example.com
VITE_SHIPROCKET_PASSWORD=your_shiprocket_password

# Environment
VITE_ENV=development

# ===================================
# GEMINI AI CONFIGURATION
# ===================================

# Google Gemini AI API Key (For AI Assistant in Admin Panel)
# Get your API key from: https://makersuite.google.com/app/apikey
# Features: Auto-fill nutritional info, Generate product descriptions
VITE_GEMINI_API_KEY=your_gemini_api_key_here
