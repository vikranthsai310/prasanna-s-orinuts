rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS FOR SECURITY
    // ============================================
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Check if user is admin (using custom claims)
    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.admin == true;
    }
    
    // Check if email is admin email (fallback)
    function isAdminEmail() {
      return isSignedIn() && 
             request.auth.token.email in ['vikranthsai310@gmail.com'];
    }
    
    // Check if phone is admin phone (fallback)
    function isAdminPhone() {
      return isSignedIn() && 
             request.auth.token.phone_number in ['+918555856366', '+916301308477'];
    }
    
    // Check if user is Super Admin
    function isSuperAdmin() {
      return isSignedIn() && 
             request.auth.token.phone_number in ['+916301308477', '+918555856366'];
    }
    
    // Validate string length
    function validString(value, minLen, maxLen) {
      return value is string && 
             value.size() >= minLen && 
             value.size() <= maxLen;
    }
    
    // Validate email format
    function validEmail(email) {
      return email is string && 
             email.matches('[^@]+@[^@]+\\.[^@]+');
    }
    
    // Validate phone number (international format +91XXXXXXXXXX)
    function validPhone(phone) {
      return phone is string && 
             phone.matches('\\+91[6-9][0-9]{9}');
    }
    
    // Check if user is suspended
    function isSuspended(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.isSuspended == true;
    }
    
    // Check if current user is not suspended
    function isNotSuspended() {
      return isSignedIn() && !isSuspended(request.auth.uid);
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Allow users to read their own profile or admins to read any profile
      allow read: if isOwner(userId) || isAdmin() || isAdminEmail() || isAdminPhone();
      
      // Allow users to create their own profile with phone number
      allow create: if isOwner(userId) && 
                       request.resource.data.phone is string &&
                       validString(request.resource.data.name, 2, 100);
      
      // Allow users to update their own profile (but not admin status or suspended status)
      // Only Super Admin can modify isAdmin and adminRole fields
      allow update: if (isOwner(userId) && 
                       request.resource.data.phone == resource.data.phone &&
                       request.resource.data.isAdmin == resource.data.isAdmin &&
                       request.resource.data.get('adminRole', null) == resource.data.get('adminRole', null) &&
                       request.resource.data.isSuspended == resource.data.isSuspended) ||
                       (isSuperAdmin()) ||
                       ((isAdmin() || isAdminEmail() || isAdminPhone()) && 
                        request.resource.data.get('adminRole', null) == resource.data.get('adminRole', null));
      
      // Only admins can delete users
      allow delete: if isAdmin() || isAdminEmail() || isAdminPhone();
    }
    
    // ============================================
    // PRODUCTS COLLECTION
    // ============================================
    match /products/{productId} {
      // Anyone can read products
      allow read: if true;
      
      // Only admins can create/update/delete products
      allow create, update, delete: if isAdmin() || isAdminEmail() || isAdminPhone();
    }
    
    // ============================================
    // ORDERS COLLECTION
    // ============================================
    match /orders/{orderId} {
      // Users can read their own orders (if not suspended), admins can read all
      allow read: if isSignedIn() && 
                     ((resource.data.userId == request.auth.uid && isNotSuspended()) || 
                      isAdmin() || 
                      isAdminEmail() ||
                      isAdminPhone());
      
      // Only non-suspended users can create orders
      allow create: if isSignedIn() && 
                       isNotSuspended() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status in ['pending', 'processing'] &&
                       request.resource.data.totalAmount is number &&
                       request.resource.data.totalAmount > 0 &&
                       request.resource.data.items is list &&
                       request.resource.data.items.size() > 0;
      
      // Only admins can update orders (status changes, etc.)
      allow update: if isAdmin() || isAdminEmail() || isAdminPhone();
      
      // Only admins can delete orders
      allow delete: if isAdmin() || isAdminEmail() || isAdminPhone();
    }
    
    // ============================================
    // ADDRESSES COLLECTION
    // ============================================
    match /addresses/{addressId} {
      // Only non-suspended users can read their own addresses
      allow read: if isSignedIn() && 
                     isNotSuspended() &&
                     resource.data.userId == request.auth.uid;
      
      // Only non-suspended users can create addresses
      allow create: if isSignedIn() && 
                       isNotSuspended() &&
                       request.resource.data.userId == request.auth.uid &&
                       validString(request.resource.data.name, 2, 100) &&
                       validString(request.resource.data.street, 5, 200) &&
                       validString(request.resource.data.city, 2, 100) &&
                       validString(request.resource.data.state, 2, 100) &&
                       request.resource.data.pincode.matches('[0-9]{6}') &&
                       validPhone(request.resource.data.phone);
      
      // Only non-suspended users can update their addresses
      allow update: if isSignedIn() && 
                       isNotSuspended() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
      
      // Only non-suspended users can delete their addresses
      allow delete: if isSignedIn() && 
                       isNotSuspended() &&
                       resource.data.userId == request.auth.uid;
    }
    
    // ============================================
    // REVIEWS COLLECTION
    // ============================================
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      
      // Only non-suspended users can create reviews
      allow create: if isSignedIn() && 
                       isNotSuspended() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.rating is int &&
                       request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       validString(request.resource.data.comment, 10, 1000);
      
      // Only non-suspended users can update their own reviews
      allow update: if isSignedIn() && 
                       isNotSuspended() &&
                       resource.data.userId == request.auth.uid;
      
      // Users can delete their own reviews (if not suspended), admins can delete any
      allow delete: if isSignedIn() && 
                       ((resource.data.userId == request.auth.uid && isNotSuspended()) || 
                        isAdmin() || 
                        isAdminEmail() ||
                        isAdminPhone());
    }
    
    // ============================================
    // CART COLLECTION (optional, if you use Firestore for carts)
    // ============================================
    match /carts/{cartId} {
      // Only non-suspended users can access their cart
      allow read, write: if isSignedIn() && 
                            isNotSuspended() &&
                            cartId == request.auth.uid;
    }
    
    // ============================================
    // COUPONS COLLECTION
    // ============================================
    match /coupons/{couponId} {
      // Anyone can read active coupons
      allow read: if true;
      
      // Only admins can create/update/delete coupons
      allow create, update, delete: if isAdmin() || isAdminEmail() || isAdminPhone();
    }
    
    // ============================================
    // PRODUCT DISCOUNTS COLLECTION
    // ============================================
    match /productDiscounts/{productId} {
      // Anyone can read discounts (needed to display discounted prices)
      allow read: if true;
      
      // Only admins can create/update/delete discounts
      allow create, update, delete: if isAdmin() || isAdminEmail() || isAdminPhone();
    }
    
    // ============================================
    // DENY ALL OTHER COLLECTIONS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
