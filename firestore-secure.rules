rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS FOR SECURITY
    // ============================================
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Check if user is admin (by checking Firestore document directly - NO TOKEN NEEDED!)
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Check if user is Super Admin (by checking adminRole in Firestore document)
    function isSuperAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('adminRole', null) == 'super-admin';
    }
    
    // Backup: Check if phone is super admin phone (for initial setup)
    function isSuperAdminPhone() {
      return isSignedIn() && 
             request.auth.token.phone_number in ['+916301308477', '+918555856366'];
    }
    
    // Validate string length
    function validString(value, minLen, maxLen) {
      return value is string && 
             value.size() >= minLen && 
             value.size() <= maxLen;
    }
    
    // Validate email format
    function validEmail(email) {
      return email is string && 
             email.matches('[^@]+@[^@]+\\.[^@]+');
    }
    
    // Validate phone number (international format +91XXXXXXXXXX)
    function validPhone(phone) {
      return phone is string && 
             phone.matches('\\+91[6-9][0-9]{9}');
    }
    
    // Check if user is suspended (safe - returns false if field doesn't exist)
    function isSuspended(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.get('isSuspended', false) == true;
    }
    
    // Check if current user is not suspended
    function isNotSuspended() {
      return isSignedIn() && !isSuspended(request.auth.uid);
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Allow users to read their own profile or admins to read any profile
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow users to create their own profile with phone number
      allow create: if isOwner(userId) && 
                       request.resource.data.phone is string &&
                       validString(request.resource.data.name, 2, 100);
      
      // Allow users to update their own profile (but not admin status or suspended status)
      // Only Super Admin can modify isAdmin and adminRole fields
      allow update: if (isOwner(userId) && 
                       request.resource.data.phone == resource.data.phone &&
                       request.resource.data.isAdmin == resource.data.isAdmin &&
                       request.resource.data.get('adminRole', null) == resource.data.get('adminRole', null) &&
                       request.resource.data.isSuspended == resource.data.isSuspended) ||
                       (isSuperAdmin() || isSuperAdminPhone()) ||
                       (isAdmin() && 
                        request.resource.data.get('adminRole', null) == resource.data.get('adminRole', null));
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // ============================================
    // PRODUCTS COLLECTION
    // ============================================
    match /products/{productId} {
      // Anyone can read products
      allow read: if true;
      
      // Only admins can create/update/delete products
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================
    // ORDERS COLLECTION
    // ============================================
    match /orders/{orderId} {
      // Users can read their own orders, admins can read all
      allow read: if isSignedIn() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can create their own orders (simplified - just check they own it)
      allow create: if isSignedIn() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Only admins can update orders (status changes, etc.)
      allow update: if isAdmin();
      
      // Only admins can delete orders
      allow delete: if isAdmin();
    }
    
    // ============================================
    // ADDRESSES COLLECTION
    // ============================================
    match /addresses/{addressId} {
      // Only non-suspended users can read their own addresses
      allow read: if isSignedIn() && 
                     isNotSuspended() &&
                     resource.data.userId == request.auth.uid;
      
      // Only non-suspended users can create addresses
      allow create: if isSignedIn() && 
                       isNotSuspended() &&
                       request.resource.data.userId == request.auth.uid &&
                       validString(request.resource.data.name, 2, 100) &&
                       validString(request.resource.data.street, 5, 200) &&
                       validString(request.resource.data.city, 2, 100) &&
                       validString(request.resource.data.state, 2, 100) &&
                       request.resource.data.pincode.matches('[0-9]{6}') &&
                       validPhone(request.resource.data.phone);
      
      // Only non-suspended users can update their addresses
      allow update: if isSignedIn() && 
                       isNotSuspended() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
      
      // Only non-suspended users can delete their addresses
      allow delete: if isSignedIn() && 
                       isNotSuspended() &&
                       resource.data.userId == request.auth.uid;
    }
    
    // ============================================
    // REVIEWS COLLECTION
    // ============================================
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      
      // Only non-suspended users can create reviews
      allow create: if isSignedIn() && 
                       isNotSuspended() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.rating is int &&
                       request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       validString(request.resource.data.comment, 10, 1000);
      
      // Only non-suspended users can update their own reviews
      allow update: if isSignedIn() && 
                       isNotSuspended() &&
                       resource.data.userId == request.auth.uid;
      
      // Users can delete their own reviews (if not suspended), admins can delete any
      allow delete: if isSignedIn() && 
                       ((resource.data.userId == request.auth.uid && isNotSuspended()) || 
                        isAdmin());
    }
    
    // ============================================
    // CART COLLECTION (optional, if you use Firestore for carts)
    // ============================================
    match /carts/{cartId} {
      // Only non-suspended users can access their cart
      allow read, write: if isSignedIn() && 
                            isNotSuspended() &&
                            cartId == request.auth.uid;
    }
    
    // ============================================
    // COUPONS COLLECTION
    // ============================================
    match /coupons/{couponId} {
      // Anyone can read active coupons
      allow read: if true;
      
      // Only admins can create/update/delete coupons
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================
    // PRODUCT DISCOUNTS COLLECTION
    // ============================================
    match /productDiscounts/{productId} {
      // Anyone can read discounts (needed to display discounted prices)
      allow read: if true;
      
      // Only admins can create/update/delete discounts
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================
    // SAMPLE PRODUCTS COLLECTION
    // ============================================
    match /sampleProducts/{sampleId} {
      // Anyone can read active samples (needed for sample selection page)
      allow read: if true;
      
      // Only admins can create/update/delete sample products
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================
    // COUPON USAGE TRACKING
    // ============================================
    match /couponUsage/{usageId} {
      // Users can read their own coupon usage (if not suspended), admins can read all
      allow read: if isSignedIn() && 
                     ((resource.data.userId == request.auth.uid && isNotSuspended()) || 
                      isAdmin());
      
      // Only non-suspended users can create usage records (when order is placed)
      allow create: if isSignedIn() && 
                       isNotSuspended() &&
                       request.resource.data.userId == request.auth.uid;
      
      // Only admins can update/delete usage records
      allow update, delete: if isAdmin();
    }
    
    // Allow collection queries for coupon usage (admins only for stats)
    match /couponUsage {
      allow list: if isAdmin();
    }
    
    // ============================================
    // SETTINGS COLLECTION (Shipping, etc.)
    // ============================================
    match /settings/{settingId} {
      // Anyone can read settings (needed for shipping calculations at checkout)
      allow read: if true;
      
      // Only admins can create/update/delete settings
      allow create, update, delete: if isAdmin();
    }
    
    // Allow collection queries for settings
    match /settings {
      allow list: if true; // Anyone can list settings for shipping calculations
    }
    
    // ============================================
    // ANALYTICS COLLECTION (Admin only)
    // ============================================
    match /analytics/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // ============================================
    // DENY ALL OTHER COLLECTIONS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
